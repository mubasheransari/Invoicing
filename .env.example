# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values. .env.local is ignored by
# git. These variables are read ONLY on the server (never sent to the browser).
# ---------------------------------------------------------------------------

# Label used to keep "already submitted" records separate (staging vs production).
FBR_ENVIRONMENT=staging

# --- Invoice source (Oracle ORDS) -----------------------------------------
ORDS_SEARCH_URL=http://tapex.mezangrp.com/ords/tea/di-invoice/search

# --- FBR / WebDNA ----------------------------------------------------------
# Sandbox and production use the same URLs; the token's scope decides which.
FBR_SUBMIT_URL=https://stg-fbrdi-gw.webdnaworks.com/diapi/v1/submitinvoice
FBR_TOKEN_URL=https://stg-fbrdi-apim.webdnaworks.com/oauth2/token
FBR_TOKEN_USERNAME=
FBR_TOKEN_PASSWORD=
# Basic client credential for the token API (Postman's {{basic_auth_0g40}}),
# e.g. "Basic dGhpcy1pcy1h..." (the "Basic " prefix is added if you omit it).
FBR_TOKEN_AUTH_HEADER=
# Alternative to the header above: consumer key + secret.
FBR_CONSUMER_KEY=
FBR_CONSUMER_SECRET=
# true = reuse a token until it nearly expires. Default false = fetch a fresh
# token before every submit.
FBR_REUSE_TOKEN=false
# TESTING ONLY: skip the token API and use this Bearer token (expires in 1h).
FBR_TEST_ACCESS_TOKEN=

# --- Seller (your company) - sent with every invoice. REQUIRED. ------------
SELLER_CODE=
SELLER_NTN_CNIC=
SELLER_BUSINESS_NAME=
SELLER_ADDRESS=
SELLER_PROVINCE=SINDH

# --- Defaults used when the ORDS data does not carry the value -------------
INVOICE_SOURCE=ERP
INVOICE_TYPE=Sale Invoice
SCENARIO_ID=SN001
DEFAULT_BUYER_REGISTRATION_TYPE=Registered
DEFAULT_SALE_TYPE=Goods at standard rate (default)
DEFAULT_UOM=Numbers, pieces, units
DEFAULT_TAX_RATE=18%
DEFAULT_SRO_SCHEDULE_NO=0
DEFAULT_SRO_ITEM_SERIAL_NO=0

# --- Site login (STRONGLY recommended before putting this on a network) ----
# When BOTH are set, every page and API route asks for this login. Leave empty
# only for local development - otherwise anyone who can open the site can
# search invoices and submit them to FBR.
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# --- Optional --------------------------------------------------------------
# Where "already submitted" records are stored (default: ./data/submissions.json)
# SUBMISSIONS_FILE=
# REQUEST_TIMEOUT_MS=25000
